@model WebBiblioteca.Models.Livro

<h1>Cadastrar Livro</h1>

<form asp-action="Create" method="post">
	<div>
		<label>Título</label>
		<input asp-for="Titulo" />
	</div>

	<div>
		<label>Tombo</label>
		<input asp-for="Tombo" />
	</div>

	<button type="submit">Salvar</button> 

</form>

<a href="/Livros">Voltar</a>
