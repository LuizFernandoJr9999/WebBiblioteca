<div asp-validation-summary="All" class="text-danger"></div>

@model WebBiblioteca.Models.Livro

<h1>Novo Livro</h1>

<form asp-action="Create" method="post">
	<div>
		<label>Sequencial</label>
		<input asp-for="Sequencial" class="form-control"  />
		<span asp-validation-for="Sequencial" class="text-danger"></span>
	</div>

	<div>
		<label>Título</label>
		<input asp-for="Titulo" class="form-control"  />
		<span asp-validation-for="Titulo" class="text-danger"></span>
	</div>

	<div>
		<label>Tombo</label>
		<input asp-for="Tombo" class="form-control" maxlength="10" onkeydown="return event.key != ' ';" style="width: 120px;" />
		<span asp-validation-for="Tombo" class="text-danger"></span>
	</div>

	<div>
		<label>Categoria</label>
		<input asp-for="Cod_Categoria" class="form-control"  />
		<span asp-validation-for="Cod_Categoria" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary">Salvar</button>

</form>

