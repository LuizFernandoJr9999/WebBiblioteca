@model Livro

<h2>Excluir Livro</h2>

<p>Tem certeza que deseja excluir o livro <strong>@Model.Titulo</strong>?</p>

<form asp-action="Delete">
    <input type="hidden" asp-for="Sequencial" />

    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
