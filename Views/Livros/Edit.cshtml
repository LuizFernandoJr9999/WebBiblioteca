@model Livro

<h2>Editar Livro</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Sequencial" />

    <div class="form-group">
        <label>Título</label>
        <input asp-for="Titulo" class="form-control" />
    </div>

    <div class="form-group">
        <label>Tombo</label>
        <input asp-for="Tombo" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>
</form>
