@model List<WebBiblioteca.Models.Livro>

    <h1>Lista de Livros</h1>

    <a asp-action ="Create" class="btn btn-primary mb-3">
        + Novo Livro
    </a>

    <table class="table table-striped table-hover"">
    <thread>
        <tr>
            <th>Sequencial</th>
			<th>Titulo</th>
            <th>Tombo</th>
            <th>Categoria</th>
        </tr>
    </thread>
    <tbody>

        @foreach (var livro in Model)
    {
        <tr>
            <td>@livro.Sequencial</td>
            <td>@livro.Titulo</td>  
            <td>@livro.Tombo</td>
            <td>@livro.Cod_Categoria</td>
            <td>
                <a asp-action="Edit" asp-route-id="@livro.Sequencial" class=" "btn btn-warning btn-sm">
                    Editar
                </a>

                    <a asp-action="Delete" asp-route-id="@livro.Sequencial" class=" " btn btn-warning btn-sm">
                        Excluir
                    </a>
            </td>
        </tr>
    }

    </tbody>
</table>

    
    
